{
  "name": "last-run-action",
  "version": "0.1.0",
  "private": true,
  "description": "A GitHub Action to determine when a workflow was last run.",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --minify",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "all": "npm run format && npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "github",
    "action",
    "last",
    "run",
    "workflow"
  ],
  "author": "Ben Balter",
  "license": "MIT",
  "dependencies": {
    "@actions/artifact": "^6.0.0",
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0",
    "async-retry": "^1.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@jest/globals": "^30.0.0",
    "@types/async-retry": "^1.4.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.0.0",
    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
